managed implementation in class zbp_dgd_i_bookstore unique;
strict ( 2 );
with draft;

define behavior for ZDGD_I_Bookstore alias Bookstore
draft table zdgd_i_bookstore_d
lock master
total etag LastChangedAt
etag master LocalLastChangedAt
authorization master ( instance )
{
  create ( authorization : global );
  update;
  delete;

  draft action Edit;
  draft action Discard;
  draft action Activate optimized;
  draft action Resume;
  draft determine action Prepare
  { validation Book~exists_in_master_data;
    validation Book~no_duplicates_in_bookstore; }

  field ( readonly, numbering : managed ) BookstoreID;
  field ( mandatory : create ) BookstoreName;
  field ( mandatory : create ) City;

  static action ReStockBook parameter ZDGD_D_ReStockBookParam;

  association _Books { create ( precheck ); with draft; }
}

define behavior for ZDGD_I_Book alias Book
draft table zdgd_i_book_d
early numbering //BookID is taken from master data
lock dependent by _Bookstore
etag dependent by _Bookstore
authorization dependent by _Bookstore
{
  update;
  delete;

  field ( readonly : update ) BookID;
  field ( readonly ) BookstoreID;
  field ( mandatory : create, readonly : update ) BookName;
  field ( mandatory : create, readonly : update ) Author;
  field ( mandatory : create, readonly : update ) Language;

  validation exists_in_master_data on save { create; }
  validation no_duplicates_in_bookstore on save { create; }

  association _Bookstore { with draft; }
}