managed implementation in class zbp_dgd_i_bookmasterdata unique;
strict ( 2 );
with draft;

define behavior for ZDGD_I_BookMasterData alias Book
draft table zdgd_i_bookmasterdata_d
lock master
total etag LastChangedAt
etag master LocalLastChangedAt
authorization master ( instance )
{
  create ( authorization : global );
  update;
  delete;

  draft action Edit;
  draft action Discard;
  draft action Activate optimized;
  draft action Resume;
  draft determine action Prepare { validation avoid_duplicates; }

  validation avoid_duplicates on save { field BookName; field Author; field Language; }

  field ( readonly, numbering : managed ) BookID;
}