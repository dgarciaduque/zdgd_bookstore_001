projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZDGD_C_Bookstore alias Bookstore
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;
  use action Resume;

  use action ReStockBook;
  use function GetDefaultsForRestockBook;

  use association _Books { create; with draft; }
}

define behavior for ZDGD_C_Book alias Book
{
  use update;
  use delete;

  use action TransferBook;

  use association _Bookstore { with draft; }
}