projection;
strict ( 2 );
use draft;

define behavior for ZDGD_C_BOOKSTORE alias Bookstore
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;
  use action Resume;

  use association _Books { create; with draft; }
}

define behavior for ZDGD_C_BOOK alias Book
{
  use update;
  use delete;

  use association _Bookstore { with draft; }
}