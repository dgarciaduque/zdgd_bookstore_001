@Metadata.layer: #CORE

annotate entity ZDGD_C_Book
  with

{
  @UI.hidden: true
  BookID;

  @UI.lineItem: [ { position: 10 } ]
  BookName;

  @UI.lineItem: [ { position: 20 } ]
  Author;

  @UI.lineItem: [ { position: 30 } ]
  UnitsInStock;

  @UI.lineItem: [ { position: 40 } ]
  Language;
}